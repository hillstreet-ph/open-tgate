FROM debian:bookworm-slim AS tdlib
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake g++ git gperf libssl-dev make php-cli zlib1g-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . /src/td
RUN cmake -S /src/td -B /build -DCMAKE_BUILD_TYPE=Release -DTD_ENABLE_JNI=OFF && cmake --build /build --target tdjson -j2

FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TDLIB_LIBRARY_PATH=/usr/local/lib/libtdjson.so
WORKDIR /app
COPY open-tgate/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY open-tgate/app ./app
COPY --from=tdlib /build/libtdjson.so /usr/local/lib/libtdjson.so
RUN mkdir -p /data/tdlib/db /data/tdlib/files && chown -R 65532:65532 /data /app
USER 65532:65532
CMD ["python", "-m", "app.worker"]
